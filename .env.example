# ============================================================
# TELEGRAM TRADING BOT — Environment Configuration
# ============================================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control!

# ── Telegram Bot ─────────────────────────────────────────────
# Get from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram user ID (get from @userinfobot)
# Comma-separated for multiple admins: 123456789,987654321
ADMIN_IDS=your_telegram_id_here

# ── Deployment ───────────────────────────────────────────────
# For production: your public HTTPS URL (no trailing slash)
# For dev: leave empty (polling mode is used)
WEBHOOK_URL=https://yourapp.railway.app

# ── Server ───────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ── Bot Settings ─────────────────────────────────────────────
# Maximum number of non-admin users allowed
MAX_USERS=50

# Set to "true" for local development (polling mode, no HTTPS needed)
# Set to "false" for production (webhook mode)
DEV_MODE=false

# ── Security (REQUIRED in production) ────────────────────────
# Encrypts users' Binance API keys in the database. Generate with:
#   python -m app.security genkey
# Back this up separately from the database. Lose it = keys unrecoverable.
ENCRYPTION_KEY=               # any long random string (16+ chars). On Render it is generated for you
# Random string; Telegram sends it on every webhook call so forged requests are rejected.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# MASTER SWITCH. false = every user is paper-trading even if they saved API keys.
# Only set true AFTER the backtest + weeks of paper trading justify it.
ALLOW_LIVE_TRADING=false

# ── Risk & costs (apply to paper AND live) ───────────────────
FEE_RATE=0.001            # 0.10% per side
SLIPPAGE_RATE=0.0005      # paper-mode assumed slippage
MAX_POSITION_PCT=30       # max % of capital in a single trade
MAX_DAILY_LOSS_PCT=3      # no new entries after losing this much today
COOLDOWN_CANDLES=3        # wait N candles after any exit
TREND_EMA=200             # only buy above this EMA (0 = off)

# ── Portfolio mode (default strategy) ────────────────────────
PORTFOLIO_SIGNAL=blend         # blend (default, 3 averaged trend signals) | ema
PORTFOLIO_TREND_EMA=50
PORTFOLIO_VOL_TARGET=0.30      # 0.20 = more conservative (smaller drawdowns, lower returns)
PORTFOLIO_REBALANCE_DAYS=1     # keep at 1: weekly results depended on which weekday you trade
DISASTER_STOP_PCT=25           # exchange-side crash protection per position
MIN_ORDER_USDT=10

# ── Idle-cash interest via Binance Simple Earn (optional) ─────
ENABLE_EARN=false              # master switch; users then opt in with /setearn on
EARN_BUFFER_PCT=15             # % of equity always kept in Spot for trading
EARN_MIN_BUFFER_USDT=20

# ── Free-tier survival (Render free plan) ───────────────────
BACKUP_TO_TELEGRAM=true        # encrypted DB copy pinned in the admin's private chat; restored after a wipe
BACKUP_INTERVAL_MIN=5
KEEPALIVE=true                 # ping our own /health so the free plan does not sleep (best effort)
KEEPALIVE_MINUTES=10

# ── Hosting ──────────────────────────────────────────────────
# Public market-data endpoints tried in order (fallback if a region is blocked by Binance)
BINANCE_PUBLIC_URLS=https://api.binance.com,https://data-api.binance.vision

# ── Database ─────────────────────────────────────────────────
DATABASE_PATH=data/trading_bot.db
